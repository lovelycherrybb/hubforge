# ============================================================
# HubForge .gitignore — 最小化上传原则
# 只跟踪「系统能跑」所必需的文件
# ============================================================

# ─── 隐私/敏感（绝不上传）───
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.jks

# ─── 依赖 ───
node_modules/
__pycache__/
*.pyc
.venv/

# ─── 构建产物 ───
dist/
build/
.next/
out/

# ─── 压缩包/二进制（不影响运行）───
*.zip
*.tar.gz
*.rar
*.7z
*.ppt
*.pptx
*.xls
*.xlsx
*.doc
*.docx

# ─── 文档/分析/运营（不影响运行）───
01-验证/
02-设计/
04-运营/
05-复盘/
06-文档/
_archive/
*.md
!03-开发/**
!AGENTS.md

# ─── 系统/IDE ───
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── 根目录临时脚本（新版在 deploy/ 下）───
deploy-reboot.sh
rebuild-portal.sh
run-seed.sh
fix-db.sh
write-compose.py
Dockerfile.simple
hubforge-*.md
华设*.md
