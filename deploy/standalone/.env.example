# ============================================================
# HubForge - Standalone 环境变量模板
# 复制为 .env 后修改
# ============================================================

# === 数据库 ===
POSTGRES_DB=hubforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
DB_PORT=5432

# === Portal ===
JWT_SECRET=change-me-a-very-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=hubforge-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORTAL_PORT=3000

# === Nginx（取消注释后生效） ===
# NGINX_PORT=80
# NGINX_SSL_PORT=443
