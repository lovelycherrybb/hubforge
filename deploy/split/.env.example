# ============================================================
# HubForge - Split 环境变量模板
# DB 服务器和应用服务器各一份，DATABASE_URL 填对方地址
# ============================================================

# === 数据库服务器 ===
POSTGRES_DB=hubforge
POSTGRES_USER=hubforge
POSTGRES_PASSWORD=change-me-in-production
DB_PORT=5432

# === 应用服务器 ===
DATABASE_URL=postgresql://hubforge:change-me-in-production@DB_SERVER_IP:5432/hubforge?schema=public
JWT_SECRET=change-me-a-very-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=hubforge-token
NEXT_PUBLIC_APP_URL=http://APP_SERVER_IP:3000
PORTAL_PORT=3000
