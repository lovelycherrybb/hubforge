# ============================================================
# HubForge - Cluster 环境变量模板
# 所有 Portal 实例共享同一份配置
# ============================================================

# === 数据库（通过 PgBouncer 连接池） ===
DATABASE_URL=postgresql://hubforge:change-me@pgbouncer:6432/hubforge?schema=public&connection_limit=10
POSTGRES_DB=hubforge
POSTGRES_USER=hubforge
POSTGRES_PASSWORD=change-me-in-production

# === PgBouncer ===
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

# === Portal ===
JWT_SECRET=change-me-a-very-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=hubforge-token
NEXT_PUBLIC_APP_URL=https://portal.example.com

# === Nginx 负载均衡 ===
NGINX_PORT=80
NGINX_SSL_PORT=443

# === MinIO 对象存储 ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BROWSER=on
