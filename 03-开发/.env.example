# ============================================================
# HubForge 环境变量配置
# 复制此文件为 .env.local 并填写实际值
# ============================================================

# 数据库连接
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hubforge?schema=public"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Cookie 名称
COOKIE_NAME="hubforge-token"

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HubForge"

# 邮件配置（用于密码重置等）
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="HubForge <noreply@example.com>"

# 日志级别
LOG_LEVEL="debug"
