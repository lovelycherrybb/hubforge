# ============================================================
# HubForge - 环境变量配置
# 复制此文件为 .env 并修改为实际值
# ============================================================

# PostgreSQL 数据库连接
DATABASE_URL=postgresql://hubforge:hubforge123@localhost:5432/hubforge

# JWT 密钥（生产环境务必更换为随机长字符串）
JWT_SECRET=your-secret-key-change-in-production

# Cookie 名称
COOKIE_NAME=hubforge-token
