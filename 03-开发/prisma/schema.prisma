// ============================================================
// HubForge - Prisma Schema
// 多租户 SaaS 平台数据库设计
// 模型: 全局用户身份 + 租户自治密码
// 隔离方案: PostgreSQL RLS + tenantId 字段
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 租户相关
// ============================================================

/// 租户 - 多租户系统的核心实体
model Tenant {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(100)
  logoUrl        String?  @db.VarChar(500)
  maxUsers       Int      @default(100)
  maxApps        Int      @default(100)
  maxOrgLevels   Int      @default(5)
  status         String   @default("active") @db.VarChar(20) // active | suspended
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy      User                 @relation(fields: [createdById], references: [id])
  users       UserTenant[]
  departments Department[]
  permissions Permission[]
  tenantApps  TenantApp[]
  apps        App[]
  userPermissions UserPermission[]
  tenantPermissions TenantPermission[]

  @@map("tenants")
}

// ============================================================
// 用户相关（全局用户池，不含密码）
// ============================================================

/// 用户 - 全局用户身份信息，不含密码
model User {
  id             String   @id @default(cuid())
  email          String   @unique @db.VarChar(255)
  name           String   @db.VarChar(100)
  avatarUrl      String?  @db.VarChar(500)
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantMemberships UserTenant[]
  organizations     UserOrganization[]
  grantedPermissions UserPermission[] @relation("UserPermissionUser")
  grantingPermissions UserPermission[] @relation("PermissionGranter")
  grantingDeptPermissions DepartmentPermission[] @relation("DeptPermissionGranter")
  createdTenants    Tenant[]
  createdApps       App[]

  @@map("users")
}

/// 用户-租户关系（含租户独立密码）
model UserTenant {
  id                String   @id @default(cuid())
  userId            String
  tenantId          String
  passwordHash      String   @db.VarChar(255)
  role              String   @default("member") @db.VarChar(20) // owner | admin | member
  status            String   @default("active") @db.VarChar(20) // active | invited | suspended
  passwordUpdatedAt DateTime?
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?
  joinedAt          DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenants")
}

// ============================================================
// 组织架构
// ============================================================

/// 部门 - 支持无限层级的树形组织架构
model Department {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  parentId  String?
  tenantId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Department?           @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[]          @relation("DepartmentTree")
  userOrgs    UserOrganization[]
  permissions DepartmentPermission[]

  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

/// 用户-组织关系
model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  isPrimary      Boolean  @default(true)

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

// ============================================================
// 权限相关
// ============================================================

/// 权限定义 - 两层权限体系
model Permission {
  id       String  @id @default(cuid())
  key      String  @db.VarChar(100)
  label    String  @db.VarChar(255)
  type     String  @default("framework") @db.VarChar(20) // framework | app
  tenantId String?
  appId    String?

  tenant           Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app              App?                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  userGrants       UserPermission[]
  departmentGrants DepartmentPermission[]
  tenantGrants     TenantPermission[]

  @@unique([key, tenantId])
  @@index([tenantId])
  @@index([appId])
  @@map("permissions")
}

/// 用户权限 - 用户与权限的多对多关系
model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  permissionId String
  grantedBy    String?
  grantedAt    DateTime @default(now())

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granter    User?      @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId, permissionId])
  @@index([userId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("user_permissions")
}

/// 部门权限 - 部门与权限的多对多关系
model DepartmentPermission {
  id           String   @id @default(cuid())
  departmentId String
  permissionId String
  grantedBy    String?
  grantedAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granter    User?      @relation("DeptPermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([departmentId, permissionId])
  @@index([departmentId])
  @@index([permissionId])
  @@map("department_permissions")
}

/// 租户权限 - 框架权限授予租户（平台 owner 控制）
/// 表示"该租户可以使用某个框架权限对应的功能"
model TenantPermission {
  id           String   @id @default(cuid())
  tenantId     String
  permissionId String
  grantedBy    String?
  grantedAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("tenant_permissions")
}

// ============================================================
// 应用相关
// ============================================================

/// 应用 - HubForge 管理的子应用（每个租户独立注册）
model App {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(100)
  type        String   @default("pc") @db.VarChar(10) // pc | h5 | both
  description String?  @db.Text
  icon        String?  @db.VarChar(500)
  url         String   @db.VarChar(500)
  config      Json?    // hubforge.config.json 内容
  status      String   @default("active") @db.VarChar(20) // active | inactive
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User       @relation(fields: [createdBy], references: [id])
  permissions Permission[]
  tenantApps  TenantApp[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("apps")
}

/// 租户-应用映射
model TenantApp {
  id        String   @id @default(cuid())
  tenantId  String
  appId     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId])
  @@index([tenantId])
  @@index([appId])
  @@map("tenant_apps")
}

// ============================================================
// 验证码
// ============================================================

/// 验证码 - 用于密码重置等场景
model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(255)
  tenantId  String   // 绑定到特定租户
  code      String   @db.VarChar(6)
  type      String   @default("reset_password") @db.VarChar(30)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, tenantId, code])
  @@index([expiresAt])
  @@map("verification_codes")
}
